{
  "name": "bluray-collection",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Gestion de collection physique de films (Blu-ray, 4K, steelbooks, customs) — TMDB + Letterboxd, hors-ligne",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5174 && cross-env BLURAY_DEV=1 electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.5"
  },
  "author": "Méli",
  "build": {
    "appId": "app.blurayCollection.desktop",
    "productName": "Blu-ray Collection",
    "executableName": "bluray-collection",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.test.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Méli <304867549+M-1u@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "M-1u",
        "repo": "bluray-collection"
      }
    ]
  },
  "homepage": "https://github.com/M-1u/bluray-collection"
}
